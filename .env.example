# Job Scrapy Configuration
# Copy this file to .env and fill in the values. Do not commit .env to version control.

# Logging
JOB_SCRAPY_LOG_LEVEL=INFO

# Limits
JOB_SCRAPY_MAX_RESULTS=20
JOB_SCRAPY_TIMEOUT=30
JOB_SCRAPY_MAX_CONCURRENCY=3

# Optional Remote API Keys
FINDWORK_API_KEY=
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
THEMUSE_API_KEY=
